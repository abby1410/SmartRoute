# Provider keys: configure at least one provider.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenAI-compatible endpoints
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Replace these example IDs with models currently available to your account.
EASY_MODEL=llama-3.1-8b-instant
MEDIUM_MODEL=llama-3.3-70b-versatile
HARD_MODEL=llama-3.3-70b-versatile
ROUTER_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile

# Provider preference: groq or openrouter
PRIMARY_PROVIDER=groq
FALLBACK_PROVIDER=

# Gateway
DATABASE_PATH=smartroute.db
CACHE_TTL_SECONDS=3600
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reliability
MAX_RETRIES=2
RETRY_BASE_SECONDS=1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30

# Optional security
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Illustrative USD cost per 1M tokens. Update from provider pricing pages.
EASY_INPUT_PRICE_PER_1M=0.05
EASY_OUTPUT_PRICE_PER_1M=0.08
MEDIUM_INPUT_PRICE_PER_1M=0.59
MEDIUM_OUTPUT_PRICE_PER_1M=0.79
HARD_INPUT_PRICE_PER_1M=0.59
HARD_OUTPUT_PRICE_PER_1M=0.79
